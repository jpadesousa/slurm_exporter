[Unit]
Description=Slurm Exporter
Documentation=https://gitea.psi.ch/HPCE/grafana-slurm-metrics
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root

ExecStart=/usr/local/bin/slurm_exporter --web.listen-address=":9341" --slurm.cluster=merlin7,gmerlin7 --collector.sacct_efficiency --command.timeout=120s

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
